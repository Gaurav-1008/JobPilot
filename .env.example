# JobPilot — consolidated environment
#
# Built by hand from problemStatement.md §14, NOT by concatenating the three
# source .env.example files (EC-P0-02): they overlap, and a concatenation lets
# the last duplicate silently win.
#
# Never commit real credentials. DRY_RUN=true stays the default for every account.

# ── LLM ──────────────────────────────────────────────────────────────
# EC-P0-04: both source projects used the name LLM_MODEL for different models.
#   Resume-Builder   LLM_MODEL=llama-3.3-70b-versatile   (Groq, tailoring)
#   The Closer       LLM_MODEL=claude-opus-4-8           (email rewrite, now Groq)
# The bare name must not survive the merge. Split:
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
TAILORING_MODEL=llama-3.3-70b-versatile
SCORING_MODEL=llama-3.1-8b-instant       # cheap Tier-1 batch pass (FR4)

# Single provider: Groq serves both the tailoring chain (①) and email
# rewriting (④). No second key, one rate limiter, one failure mode.
# EMAIL_LLM_MODEL stays a separate variable so email rewriting can be tuned
# independently of tailoring without adding a provider.
EMAIL_LLM_MODEL=llama-3.3-70b-versatile  # absent key => template fallback

# ── Scraping ─────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=
SCRAPE_RATE_LIMIT_PER_MIN=10
# EC-P3-02: this TTL gates REFRESH eligibility only. Entries are never evicted.
HYDRATION_CACHE_TTL_DAYS=30

# ── Auth — Supabase Auth (architecture.md §22.1) ─────────────────────
# GoTrue IS Supabase Auth, and runs against our own Postgres, so no hosted
# project is required. `docker compose up -d auth` starts it on :9999.
#
# The anon key below is the standard local GoTrue development key, signed with
# the GOTRUE_JWT_SECRET in docker-compose.yml. It is public by design (it is
# shipped to the browser) and grants nothing on its own.
#
# HOSTED SUPABASE: point NEXT_PUBLIC_SUPABASE_URL at the project, paste its
# anon key, and delete the `auth` service from docker-compose. No code changes.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:9999
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Data ─────────────────────────────────────────────────────────────
DATABASE_URL=
REDIS_URL=
STORAGE_BUCKET=jobpilot
# fs (default, no MinIO needed) or s3. The default cannot talk to a real bucket.
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=.storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=jobpilot
S3_SECRET_KEY=local_dev_only
# EC-P1-15: keep below the hosting platform's request body limit (Vercel 4.5MB),
# or the user gets an opaque 413 before this check ever runs.
MAX_UPLOAD_MB=4

# ── Outreach safety — defaults are deliberately strict ───────────────
# EC-P0-27 / safety test 7: absent values must resolve to the SAFE option,
# never to sending. Config is read through a function, not at import time.
#
# JOBPILOT_ENV gates the forced-dry-run override (P0.4.4). In local, test, ci,
# and staging, DRY_RUN=false is IGNORED and dry-run is forced on — a staging bug
# must not be able to email a real person (EC-P7-23). Only "production" honours
# DRY_RUN=false. Absent => "local" => forced. Never set this to production
# outside the real production deployment.
JOBPILOT_ENV=local
DRY_RUN=true
SEND_MODE=draft
PROVIDER=gmail
MAX_OUTREACH_PER_DAY=5                   # rolling 24h window, not per-run
EMAIL_WORD_LIMIT=150
DEDUPE=true

# ── Services ─────────────────────────────────────────────────────────
WORKER_SERVICE_URL=http://localhost:8000
WORKER_SERVICE_TOKEN=
ENCRYPTION_KEY=                          # per-user credential envelope (AES-256-GCM)
ENCRYPTION_KEY_VERSION=1                 # EC-P5-67: rotation needs versioning
