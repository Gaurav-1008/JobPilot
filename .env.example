# JobPilot — consolidated environment
#
# Built by hand from problemStatement.md §14, NOT by concatenating the three
# source .env.example files (EC-P0-02): they overlap, and a concatenation lets
# the last duplicate silently win.
#
# Never commit real credentials. DRY_RUN=true stays the default for every account.

# ── LLM ──────────────────────────────────────────────────────────────
# EC-P0-04: both source projects used the name LLM_MODEL for different models.
#   Resume-Builder   LLM_MODEL=llama-3.3-70b-versatile   (Groq, tailoring)
#   The Closer       LLM_MODEL=claude-opus-4-8           (email rewrite, now Groq)
# The bare name must not survive the merge. Split:
# MODEL IDS EXPIRE. Groq retires hosted models on its own schedule, so a
# deployment that worked yesterday can return 404 `model_not_found` today with
# nothing changed on our side — it is the most likely cause of a sudden total
# LLM outage, and it is fixed by editing the three values below.
#
# Check what your account can actually reach:
#   curl -s https://api.groq.com/openai/v1/models \
#     -H "Authorization: Bearer $GROQ_API_KEY" | jq -r '.data[].id' | sort
#
# The pipeline needs models supporting `response_format: json_object`, and it
# needs enough max_tokens for reasoning models to finish — truncation surfaces
# as Groq's "Failed to validate JSON", which looks like a prompt bug.
#
# The llama-3.x ids this project shipped with were decommissioned.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
TAILORING_MODEL=openai/gpt-oss-120b
SCORING_MODEL=openai/gpt-oss-20b           # cheap Tier-1 batch pass (FR4)

# Single provider: Groq serves both the tailoring chain (①) and email
# rewriting (④). No second key, one rate limiter, one failure mode.
# EMAIL_LLM_MODEL stays a separate variable so email rewriting can be tuned
# independently of tailoring without adding a provider.
EMAIL_LLM_MODEL=openai/gpt-oss-120b       # absent key => template fallback

# ── Scraping ─────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=
SCRAPE_RATE_LIMIT_PER_MIN=10
# EC-P3-02: this TTL gates REFRESH eligibility only. Entries are never evicted.
HYDRATION_CACHE_TTL_DAYS=30

# ── Auth — Supabase (architecture.md §22.1) ──────────────────────────
# Hosted project. Dashboard -> Project Settings -> API.
#
# The anon key is PUBLIC by design — it ships to the browser and grants nothing
# on its own; row access is governed by RLS and by our tenant-scoped repository.
# Safe to commit if you want to; left blank here so a fork does not inherit it.
#
# NEVER put the `service_role` key in this file or in the app. It bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Offline alternative: `docker compose --profile local-auth up -d auth` runs
# GoTrue (which IS Supabase Auth) against local Postgres, then set
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:9999. No code changes either way.

# ── Data ─────────────────────────────────────────────────────────────
# Supabase gives you TWO connection strings, and Prisma needs both:
#
#   DATABASE_URL  the POOLED one (Supavisor, port 6543, ?pgbouncer=true).
#                 Used at runtime. Serverless opens many short-lived
#                 connections and would exhaust a direct pool.
#   DIRECT_URL    the DIRECT one (port 5432). Used for migrations only —
#                 pgbouncer in transaction mode cannot run DDL or advisory
#                 locks, so `prisma migrate` fails against the pooled URL with
#                 a confusing error.
#
# Dashboard -> Project Settings -> Database -> Connection string.
# Contains your database password: keep it in .env, never in .env.example.
DATABASE_URL=
DIRECT_URL=
REDIS_URL=
STORAGE_BUCKET=jobpilot
# fs (default, no MinIO needed) or s3. The default cannot talk to a real bucket.
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=.storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=jobpilot
S3_SECRET_KEY=local_dev_only
# EC-P1-15: keep below the hosting platform's request body limit (Vercel 4.5MB),
# or the user gets an opaque 413 before this check ever runs.
MAX_UPLOAD_MB=4

# ── Outreach safety — defaults are deliberately strict ───────────────
# EC-P0-27 / safety test 7: absent values must resolve to the SAFE option,
# never to sending. Config is read through a function, not at import time.
#
# JOBPILOT_ENV gates the forced-dry-run override (P0.4.4). In local, test, ci,
# and staging, DRY_RUN=false is IGNORED and dry-run is forced on — a staging bug
# must not be able to email a real person (EC-P7-23). Only "production" honours
# DRY_RUN=false. Absent => "local" => forced. Never set this to production
# outside the real production deployment.
JOBPILOT_ENV=local
DRY_RUN=true
SEND_MODE=draft
PROVIDER=gmail
MAX_OUTREACH_PER_DAY=5                   # rolling 24h window, not per-run
EMAIL_WORD_LIMIT=150
DEDUPE=true

# ── Services ─────────────────────────────────────────────────────────
WORKER_SERVICE_URL=http://localhost:8000
WORKER_SERVICE_TOKEN=
ENCRYPTION_KEY=                          # per-user credential envelope (AES-256-GCM)
ENCRYPTION_KEY_VERSION=1                 # EC-P5-67: rotation needs versioning

# EC-P7-27 — DURING A ROTATION ONLY, and required for its whole duration.
#
# Rotation is: publish the new key as ENCRYPTION_KEY, move the OLD key here,
# bump ENCRYPTION_KEY_VERSION. Both versions then decrypt while requests are in
# flight — under a rolling deploy that overlap lasts as long as the rollout,
# with both app versions serving at once.
#
# Swapping ENCRYPTION_KEY in place without setting this bricks every stored
# credential: the new key cannot decrypt old rows, and because GCM
# authenticates, the failure is total rather than partial.
#
# Remove only once `npm run verify:key-rotation` reports zero rows on v1.
# Full procedure: docs/runbooks/encryption-key-rotation.md
# ENCRYPTION_KEY_V1=

# ── Orchestrator (③) ─────────────────────────────────────────────────
# In-flight jobs per replica. Also sizes ③'s Prisma pool (concurrency + 2),
# so the two cannot drift apart.
#
# ③ connects via DIRECT_URL (:5432, session mode) rather than the pooled
# :6543, because it is a PERSISTENT worker and transaction-mode pooling is
# built for the opposite shape. The cost is that each pool slot holds a real
# backend, and Supabase reports max_connections = 60 shared with PostgREST,
# pg_cron and the rest — so leaving Prisma's default (num_cpus * 2 + 1 = 17
# on an 8-core machine) lets one worker claim a large share of the instance
# for work bounded at 4.
ORCHESTRATOR_CONCURRENCY=4

# ── Observability ────────────────────────────────────────────────────
# P7.3.3 — bearer token for GET /api/metrics (Prometheus text format).
#
# UNSET MEANS THE ENDPOINT 404s, which is the intended default. Metrics
# describe the shape of the system and are reconnaissance even though no label
# carries an id (EC-P7-20), so "unconfigured" has to resolve to closed rather
# than open — invariant 3.
METRICS_TOKEN=
