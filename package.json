{
  "name": "jobpilot",
  "version": "0.0.0",
  "private": true,
  "description": "Unified job-search platform: harvest -> tailor -> reach -> track",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "test": "npm run test --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "py:install": "python3 -m pip install -r services/python/requirements.txt",
    "py:harvest": "python3 services/python/harvester/harvester.py",
    "py:outreach": "python3 services/python/outreach/main.py",
    "schemas:gen": "echo 'P0.2.4 not implemented yet' && exit 1",
    "db:migrate": "echo 'P0.3.2 not implemented yet' && exit 1"
  }
}
