{
  "name": "jobpilot",
  "version": "0.0.0",
  "private": true,
  "description": "Unified job-search platform: harvest -> tailor -> reach -> track",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "test": "npm run test --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "py:install": "python3 -m pip install -r services/python/requirements.txt",
    "py:harvest": "python3 services/python/harvester/harvester.py",
    "py:outreach": "python3 services/python/outreach/main.py",
    "schemas:gen": "npm run generate --workspace=packages/shared-schemas",
    "db:migrate": "npm run db:migrate --workspace=apps/web",
    "db:seed": "npm run db:seed --workspace=apps/web",
    "db:generate": "npm run db:generate --workspace=apps/web",
    "schemas:check": "npm run check --workspace=packages/shared-schemas",
    "db:verify": "node scripts/verify-migration.mjs",
    "verify:phase1": "node --env-file=.env scripts/verify-phase1.mjs",
    "verify:key-rotation": "node --env-file=.env scripts/verify-key-rotation.mjs",
    "rotate:credentials": "node --env-file=.env scripts/rotate-credentials.mjs",
    "reap:deletions": "npx tsx --env-file=.env scripts/reap-deletions.mjs",
    "worker": "npx tsx --env-file=.env services/orchestrator/index.ts",
    "py:worker": "cd services/python && ../../.venv/bin/python -m uvicorn main:app --port 8000"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4"
  }
}
