# ─────────────────────────────────────────────────────────────────────────────
# The repo-root `.env` is the source of truth. Every service reads from it —
# the orchestrator and the seed scripts via `--env-file=.env`, this app via the
# `apps/web/.env.local -> ../../.env` symlink.
#
# Next resolves env files against ITS project root (apps/web), not the repo
# root, so without that symlink the vars below are simply absent here. When
# NEXT_PUBLIC_SUPABASE_* go missing, proxy.ts takes its default-deny branch and
# every protected route answers 503 AUTH_NOT_CONFIGURED while `/` still renders
# fine — which reads like a broken app rather than missing config.
#
# Set up a fresh clone with:
#   cp .env.example .env                  # at the repo root, then fill it in
#   ln -sfn ../../.env apps/web/.env.local
#
# Confirm it took: `next dev` prints `- Environments: .env.local` on boot.
# This file documents only what apps/web reads; the root .env.example is the
# full list.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Auth — required. Without both, proxy.ts 503s every protected route.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Groq LLM (used from Phase 2 onward — not required to run the Phase 1 mock flow)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
TAILORING_MODEL=llama-3.3-70b-versatile  # renamed from LLM_MODEL (EC-P0-04)

# Resume upload limit (Phase 5)
MAX_UPLOAD_MB=5

# ── Outreach delivery (Phase 5) ───────────────────────────────────────────────
# Credential envelope. Without it, sending credentials CANNOT be stored and
# interlock check 11 blocks every real send — dry run still works. That is the
# intended fail-closed behavior, not a bug. Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1
# Keep the previous key here when rotating, or every stored credential becomes
# undecryptable (EC-P5-67). Add ENCRYPTION_KEY_V2, _V3, … as versions advance.
# ENCRYPTION_KEY_V1=

# Gmail OAuth (P5.5.3). Optional: SMTP works without it, but draft mode does
# not — SMTP has no concept of a remote draft. Create an OAuth client of type
# "Web application" in Google Cloud Console and register the redirect URI below
# EXACTLY as it appears here; Google requires a byte-for-byte match.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${NEXT_PUBLIC_APP_URL}/api/outreach/oauth/google/callback.
# Never derived from the request Host header — that is attacker-controlled.
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/outreach/oauth/google/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000