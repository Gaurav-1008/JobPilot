# SMTP settings (only required for a future real SEND_MODE=send run)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_NAME=Your Name

# Safety defaults: do not make network calls or deliver messages.
DRY_RUN=true
SEND_MODE=draft
MAX_OUTREACH_PER_RUN=5
INPUT_PATH=contacts.json

# --- Phase 8 stretch settings (all optional; safe defaults shown) ---
# Delivery provider: smtp (default) or gmail (Gmail API drafts/sends).
PROVIDER=smtp
# Audit log location.
LOG_PATH=outreach_log.csv
# Suppress addresses listed here (one email per line, or a CSV with a
# recipient_email column). Always applied when the file exists.
OPT_OUT_PATH=do_not_contact.csv
# Skip recipients already marked sent/drafted in LOG_PATH.
DEDUPE=false
# Use an LLM to rewrite the email body (falls back to the template on any error).
# Provider is Groq via its OpenAI-compatible endpoint — the same provider the
# tailoring chain uses. Changed from Anthropic in the JobPilot merge; the
# platform is deliberately single-provider (docs/architecture.md §12.2).
USE_LLM=false
EMAIL_LLM_MODEL=llama-3.3-70b-versatile  # renamed from LLM_MODEL (EC-P0-04)
# GROQ_API_KEY is read from the environment when USE_LLM=true.
# Absent => template fallback, never an error.
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Gmail API OAuth files (only when PROVIDER=gmail).
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
